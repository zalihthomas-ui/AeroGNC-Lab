* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Cross-platform source, configuration, documentation, and provenance records.
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.cff text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.m text eol=lf
*.f text eol=lf
*.f90 text eol=lf
*.F90 text eol=lf
*.sh text eol=lf

# Native Windows launchers retain conventional line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated/media/model assets must never be newline-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.npz binary
*.npy binary
*.mat binary
*.slx binary
*.stl binary
